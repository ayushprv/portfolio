{
  "rewrites": [
    {
      "source": "/gallery/:path*",
      "destination": "/gallery-post.html"
    }
  ],
  "redirects": [
    {
      "source": "/blogs.html",
      "destination": "/gallery.html",
      "permanent": true
    },
    {
      "source": "/blogs/2026/:path*",
      "destination": "/gallery/2026/:path*",
      "permanent": true
    }
  ]
}
